+        'zene és kiadványok' => 'Music and Releases',
+        'játékok' => 'Games',
+        'szavazás és nyereményjáték' => 'Voting and Giveaways',
+        'segítség és adatvédelem' => 'Help and Privacy',
+        'app és közösség' => 'App and Community',
+    );
+}
