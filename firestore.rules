rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'djdeeroy@gmail.com'
          || (exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid))
            && (get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.accessRole == 'admin'
              || get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.role == 'admin')));
    }

    function isModerator() {
      return isAdmin()
        || (request.auth != null
          && exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.accessRole == 'moderator');
    }

    function normalizedAccountRole(role) {
      return role == 'organizer' || role == 'admin'
        ? 'organizer'
        : role == 'dj' ? 'dj' : 'partygoer';
    }

    function normalizedAccessRole(role) {
      return role == 'admin' || role == 'moderator' ? role : 'none';
    }

    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /live_feed_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/community_bans/$(request.auth.uid))
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorImageUrl', 'authorRole',
          'authorAccessRole', 'text', 'imageUrl',
          'reactions', 'reactionBy', 'pinned', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorImageUrl is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.imageUrl is string
        && request.resource.data.reactions is map
        && request.resource.data.reactionBy is map
        && !exists(/databases/$(database)/documents/community_bans/$(request.auth.uid))
        && (request.resource.data.pinned == false || isAdmin())
        && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            ? request.resource.data.authorRole == ''
              && request.resource.data.authorAccessRole == ''
            : (!exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid))
                ? request.resource.data.authorRole == 'partygoer'
                  && request.resource.data.authorAccessRole == 'none'
                : request.resource.data.authorRole == normalizedAccountRole(get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.role)
                  && request.resource.data.authorAccessRole == normalizedAccessRole(get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.accessRole)))
        && (request.auth.token.firebase.sign_in_provider != 'anonymous'
            || request.resource.data.imageUrl == '');
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions', 'reactionBy'
        ])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.text == resource.data.text
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.reactions is map
        && request.resource.data.reactionBy is map;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
        && request.resource.data.pinned is bool;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin();
    }

    match /community_profiles/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isRegistered());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (request.auth.token.email == 'djdeeroy@gmail.com'
            ? request.resource.data.role == 'organizer' && request.resource.data.accessRole == 'admin'
            : isAdmin()
            || (request.resource.data.role in ['dj', 'organizer', 'partygoer']
              && (!request.resource.data.keys().hasAny(['accessRole'])
                || request.resource.data.accessRole == 'none')));
      allow update: if request.auth != null
        && ((request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email', 'socialLinks', 'bio', 'profileImageUrl',
            'profileFocusX', 'profileFocusY', 'profileSourceImageUrl', 'profileZoom', 'profilePanX', 'profilePanY', 'updatedAt', 'fcmTokens'
          ])
          && (request.resource.data.role == resource.data.role
            || (!resource.data.keys().hasAny(['role'])
                && request.resource.data.role in ['dj', 'organizer', 'partygoer']))
          && (!request.resource.data.keys().hasAny(['accessRole'])
            || request.resource.data.accessRole == resource.data.accessRole)
          && (!request.resource.data.keys().hasAny(['fcmTokens'])
            || request.resource.data.fcmTokens is list))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'email', 'socialLinks', 'bio', 'profileImageUrl',
              'profileFocusX', 'profileFocusY', 'profileSourceImageUrl', 'profileZoom', 'profilePanX', 'profilePanY', 'updatedAt', 'role', 'accessRole', 'fcmTokens'
            ])
            && (request.auth.uid == userId
              && request.auth.token.email == 'djdeeroy@gmail.com'
              ? request.resource.data.role == 'organizer' && request.resource.data.accessRole == 'admin'
              : request.resource.data.role in ['dj', 'organizer', 'partygoer'])
            && (!request.resource.data.keys().hasAny(['accessRole'])
              || request.resource.data.accessRole in ['none', 'moderator', 'admin'])
            && (!request.resource.data.keys().hasAny(['fcmTokens'])
              || request.resource.data.fcmTokens is list)));
    }

    match /community_profiles/{userId}/favorites/{favoriteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.kind is string
        && request.resource.data.id is int
        && request.resource.data.title is string;
    }

    match /news_reactions/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['count', 'likedBy'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.likedBy is map;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['count', 'likedBy'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.likedBy is map;
      allow delete: if isAdmin();
    }

    match /community_profiles/{userId}/blocked_users/{blockedId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /community_profiles/{userId}/planned_events/{eventId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.eventId is int
        && request.resource.data.state == 'attending';
    }

    match /event_attendance/{eventId}/users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.state in ['attending', 'not_attending'];
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /community_profiles/{userId}/connections/{otherUserId} {
      allow read: if isRegistered();
      allow write: if isAdmin() || (isRegistered()
        && (request.auth.uid == userId || request.auth.uid == otherUserId));
    }

    match /connection_requests/{requestId} {
      allow read: if isRegistered();
      allow create: if isRegistered()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isRegistered()
        && ((resource.data.to == request.auth.uid
              && request.resource.data.status in ['accepted', 'rejected'])
            || (resource.data.from == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'notificationRequestedAt']))
            || isAdmin());
      allow delete: if isRegistered()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
    }

    match /chat_reports/{reportId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.reason is string;
      allow read: if isModerator()
        || (request.auth != null && resource.data.reporterId == request.auth.uid);
      allow delete: if isModerator();
      allow update: if isAdmin();
    }

    match /private_conversations/{conversationId} {
      allow read: if isRegistered()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isRegistered()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'participantNames', 'lastMessage',
          'lastSenderId', 'updatedAt'
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedAt is timestamp;
      allow update: if isRegistered()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastSenderId', 'updatedAt'
        ])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedAt is timestamp;

      match /messages/{messageId} {
        allow read: if isRegistered()
          && request.auth.uid in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds;
        allow create: if isRegistered()
          && request.auth.uid in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.keys().hasOnly([
            'senderId', 'recipientId', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.recipientId in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds
          && !exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid)/blocked_users/$(request.resource.data.recipientId))
          && !exists(/databases/$(database)/documents/community_profiles/$(request.resource.data.recipientId)/blocked_users/$(request.auth.uid))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /community_bans/{userId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /artist_claims/{artistId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    match /app_settings/{settingId} {
      allow read: if settingId == 'startup';
      allow write: if isAdmin();
    }

    match /voting_votes/{voteId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && voteId == string(request.resource.data.seasonId) + '_' + request.resource.data.category + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['seasonId', 'category', 'candidateIds', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.seasonId is int
        && request.resource.data.category is string
        && request.resource.data.candidateIds is list
        && request.resource.data.candidateIds.size() > 0
        && (
          (request.resource.data.category == 'hungarian_organizer' && request.resource.data.candidateIds.size() <= 1)
          || (request.resource.data.category == 'hungarian_hardstyle_dj' && request.resource.data.candidateIds.size() <= 5)
          || (request.resource.data.category == 'hungarian_hardcore_dj' && request.resource.data.candidateIds.size() <= 3)
          || (request.resource.data.category == 'hungarian_track' && request.resource.data.candidateIds.size() <= 2)
          || (request.resource.data.category == 'international_dj' && request.resource.data.candidateIds.size() <= 3)
        )
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
