rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'djdeeroy@gmail.com'
          || (exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid))
            && (get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.accessRole == 'admin'
              || get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.role == 'admin')));
    }

    function isModerator() {
      return isAdmin()
        || (request.auth != null
          && exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.accessRole == 'moderator');
    }

    function normalizedAccountRole(role) {
      return role == 'organizer' || role == 'admin'
        ? 'organizer'
        : role == 'dj' ? 'dj' : 'partygoer';
    }

    function normalizedAccessRole(role) {
      return role == 'admin' || role == 'moderator' ? role : 'none';
    }

    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !exists(/databases/$(database)/documents/deleted_user_ids/$(request.auth.uid));
    }

    function isAllowedUploadedImage(url) {
      return url is string
        && (url == ''
          || url.matches('^https://res\\.cloudinary\\.com/fjxo93em/image/upload/.+'));
    }

    match /live_feed_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/deleted_user_ids/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/community_bans/$(request.auth.uid))
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorImageUrl', 'authorRole',
          'authorAccessRole', 'isAnonymous', 'text', 'replyToText', 'imageUrl', 'imagePublicId',
          'reactions', 'reactionBy', 'pinned', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && (!request.resource.data.keys().hasAny(['isAnonymous'])
            || request.resource.data.isAnonymous is bool)
        && isAllowedUploadedImage(request.resource.data.authorImageUrl)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (!request.resource.data.keys().hasAny(['replyToText'])
            || (request.resource.data.replyToText is string
                && request.resource.data.replyToText.size() <= 200))
        && isAllowedUploadedImage(request.resource.data.imageUrl)
        && (!request.resource.data.keys().hasAny(['imagePublicId'])
            || (request.resource.data.imagePublicId is string
                && request.resource.data.imagePublicId.matches('^huhs_users/' + request.auth.uid + '/.+')))
        && request.resource.data.reactions is map
        && request.resource.data.reactionBy is map
        && !exists(/databases/$(database)/documents/community_bans/$(request.auth.uid))
        && (request.resource.data.pinned == false || isAdmin())
        && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            ? request.resource.data.authorRole == ''
              && request.resource.data.authorAccessRole == ''
              && (!request.resource.data.keys().hasAny(['isAnonymous'])
                  || request.resource.data.isAnonymous == true)
            : (!exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid))
                ? request.resource.data.authorRole == 'partygoer'
                  && request.resource.data.authorAccessRole == 'none'
                : request.resource.data.authorRole == normalizedAccountRole(get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.role)
                  && request.resource.data.authorAccessRole == normalizedAccessRole(get(/databases/$(database)/documents/community_profiles/$(request.auth.uid)).data.accessRole))
              && (!request.resource.data.keys().hasAny(['isAnonymous'])
                  || request.resource.data.isAnonymous == false))
        && (request.auth.token.firebase.sign_in_provider != 'anonymous'
            || request.resource.data.imageUrl == '');
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
        && request.resource.data.pinned is bool;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin();
    }

    match /community_profiles/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/deleted_user_ids/$(request.auth.uid))
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'role', 'accessRole', 'socialLinks', 'bio',
          'profileImageUrl', 'profileImagePublicId', 'profileFocusX', 'profileFocusY',
          'profileSourceImageUrl', 'profileSourceImagePublicId', 'profileZoom', 'profilePanX', 'profilePanY',
          'createdAt', 'updatedAt', 'fcmTokens'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string
            && request.resource.data.email == request.auth.token.email))
        && (!request.resource.data.keys().hasAny(['bio'])
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 2000))
        && (!request.resource.data.keys().hasAny(['profileImageUrl'])
          || isAllowedUploadedImage(request.resource.data.profileImageUrl))
        && (!request.resource.data.keys().hasAny(['profileSourceImageUrl'])
          || isAllowedUploadedImage(request.resource.data.profileSourceImageUrl))
        && (!request.resource.data.keys().hasAny(['profileImagePublicId'])
          || (request.resource.data.profileImagePublicId is string
            && request.resource.data.profileImagePublicId.matches('^huhs_users/' + request.auth.uid + '/.+')))
        && (!request.resource.data.keys().hasAny(['profileSourceImagePublicId'])
          || (request.resource.data.profileSourceImagePublicId is string
            && request.resource.data.profileSourceImagePublicId.matches('^huhs_users/' + request.auth.uid + '/.+')))
        && (!request.resource.data.keys().hasAny(['socialLinks'])
          || request.resource.data.socialLinks is map)
        && (!request.resource.data.keys().hasAny(['fcmTokens'])
          || request.resource.data.fcmTokens is list)
        && (!request.resource.data.keys().hasAny(['role'])
          || (isAdmin()
            ? request.resource.data.role in ['dj', 'organizer', 'partygoer']
            : request.resource.data.role in ['dj', 'organizer', 'partygoer']))
        && (!request.resource.data.keys().hasAny(['accessRole'])
          || (isAdmin()
            ? request.resource.data.accessRole in ['none', 'moderator', 'admin']
            : request.resource.data.accessRole == 'none'));
      allow update: if request.auth != null
        && !exists(/databases/$(database)/documents/deleted_user_ids/$(request.auth.uid))
        && ((request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email', 'socialLinks', 'bio', 'profileImageUrl', 'profileImagePublicId',
            'profileFocusX', 'profileFocusY', 'profileSourceImageUrl', 'profileSourceImagePublicId', 'profileZoom', 'profilePanX', 'profilePanY', 'createdAt', 'updatedAt', 'fcmTokens', 'role', 'accessRole'
          ])
          && (!request.resource.data.keys().hasAny(['email'])
            || request.resource.data.email == request.auth.token.email)
          && (!request.resource.data.keys().hasAny(['profileImageUrl'])
            || isAllowedUploadedImage(request.resource.data.profileImageUrl))
          && (!request.resource.data.keys().hasAny(['profileSourceImageUrl'])
            || isAllowedUploadedImage(request.resource.data.profileSourceImageUrl))
          && (!request.resource.data.keys().hasAny(['profileImagePublicId'])
            || (request.resource.data.profileImagePublicId is string
              && request.resource.data.profileImagePublicId.matches('^huhs_users/' + request.auth.uid + '/.+')))
          && (!request.resource.data.keys().hasAny(['profileSourceImagePublicId'])
            || (request.resource.data.profileSourceImagePublicId is string
              && request.resource.data.profileSourceImagePublicId.matches('^huhs_users/' + request.auth.uid + '/.+')))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
            || (!resource.data.keys().hasAny(['createdAt'])
              && request.resource.data.createdAt is timestamp))
          && ((!request.resource.data.keys().hasAny(['role'])
                && !resource.data.keys().hasAny(['role']))
            || request.resource.data.role == resource.data.role
            || (!resource.data.keys().hasAny(['role'])
                && request.resource.data.role in ['dj', 'organizer', 'partygoer']))
          && ((!request.resource.data.keys().hasAny(['accessRole'])
                && !resource.data.keys().hasAny(['accessRole']))
            || request.resource.data.accessRole == resource.data.accessRole
            || (!resource.data.keys().hasAny(['accessRole'])
              && request.resource.data.accessRole == 'none'))
          && (!request.resource.data.keys().hasAny(['fcmTokens'])
            || request.resource.data.fcmTokens is list))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'email', 'socialLinks', 'bio', 'profileImageUrl', 'profileImagePublicId',
              'profileFocusX', 'profileFocusY', 'profileSourceImageUrl', 'profileSourceImagePublicId', 'profileZoom', 'profilePanX', 'profilePanY', 'updatedAt', 'role', 'accessRole', 'fcmTokens'
            ])
            && (request.auth.uid == userId
              && request.auth.token.email == 'djdeeroy@gmail.com'
              ? request.resource.data.role == 'organizer' && request.resource.data.accessRole == 'admin'
              : request.resource.data.role in ['dj', 'organizer', 'partygoer'])
            && (!request.resource.data.keys().hasAny(['accessRole'])
              || request.resource.data.accessRole in ['none', 'moderator', 'admin'])
            && (!request.resource.data.keys().hasAny(['fcmTokens'])
              || request.resource.data.fcmTokens is list)));
    }

    // This is a public-only projection: it contains no email, push token or
    // private moderation data. It is readable without login so chat badges
    // and public profiles can render immediately for signed-out users.
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Blocks already-issued tokens for a deleted UID. Re-registering the same
    // email or Google identity creates a new UID and remains allowed.
    match /deleted_user_ids/{userId} {
      allow read, write: if false;
    }

    // One-way markers retained solely to prevent re-registration after a
    // complete account deletion. The raw email is never stored.
    match /deleted_identity_hashes/{identityHash} {
      allow read, write: if false;
    }

    // Achievement points and the ledger are server-managed. Clients may read
    // the public profile summary, but can never award themselves points.
    match /achievement_ledger/{entryId} {
      allow read, write: if false;
    }

    // Game attempts and aggregate results are written only by Cloud
    // Functions. The client can submit through the callable, never directly
    // to these collections.
    match /game_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /game_stats/{gameId} {
      allow read, write: if false;
    }

    // Device push tokens are private user data, not public profile data.
    match /private_user_data/{userId} {
      allow read: if isRegistered() && request.auth.uid == userId;
      allow create, update: if isRegistered()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['fcmTokens', 'notificationPreferences', 'updatedAt'])
        && (!request.resource.data.keys().hasAny(['fcmTokens'])
          || request.resource.data.fcmTokens is list)
        && (!request.resource.data.keys().hasAny(['notificationPreferences'])
          || (request.resource.data.notificationPreferences is map
            && request.resource.data.notificationPreferences.keys().hasOnly(['enabled', 'achievements'])
            && request.resource.data.notificationPreferences.enabled is bool
            && request.resource.data.notificationPreferences.achievements is bool));
      allow delete: if isRegistered() && request.auth.uid == userId;
    }

    match /community_profiles/{userId}/favorites/{favoriteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.kind is string
        && request.resource.data.id is int
        && request.resource.data.title is string;
    }

    match /news_reactions/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /event_ratings/{eventId}/users/{userId} {
      allow read: if isRegistered();
      allow write: if false;
    }

    match /community_profiles/{userId}/blocked_users/{blockedId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /community_profiles/{userId}/planned_events/{eventId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.eventId is int
        && request.resource.data.eventId == int(eventId)
        && request.resource.data.state == 'attending';
    }

    match /event_attendance/{eventId}/users/{userId} {
      allow read: if isRegistered();
      allow write: if false;
    }

    // Meetup is scoped to one event. Registered users can read the list;
    // only users attending that event can create or interact with entries.
    match /event_meetups/{eventId}/users/{userId} {
      allow read: if isRegistered();
      allow create: if isRegistered()
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/event_attendance/$(eventId)/users/$(request.auth.uid)).data.state == 'attending'
        && request.resource.data.keys().hasOnly([
          'eventId', 'eventTitle', 'userId', 'displayName', 'imageUrl',
          'interestedBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.eventId is int
        && request.resource.data.eventId == int(eventId)
        && request.resource.data.userId == userId
        && request.resource.data.interestedBy is map
        && request.resource.data.interestedBy.keys().size() == 0
        && !exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid)/blocked_users/$(userId))
        && !exists(/databases/$(database)/documents/community_profiles/$(userId)/blocked_users/$(request.auth.uid));
      allow update: if isRegistered()
        && get(/databases/$(database)/documents/event_attendance/$(eventId)/users/$(request.auth.uid)).data.state == 'attending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedBy'])
        && request.resource.data.interestedBy is map
        && request.resource.data.interestedBy.diff(resource.data.interestedBy).affectedKeys().hasOnly([request.auth.uid])
        && !exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid)/blocked_users/$(userId))
        && !exists(/databases/$(database)/documents/community_profiles/$(userId)/blocked_users/$(request.auth.uid));
      allow delete: if isRegistered() && request.auth.uid == userId;
    }

    match /community_profiles/{userId}/connections/{otherUserId} {
      allow read: if isRegistered();
      allow write: if false;
    }

    match /connection_requests/{requestId} {
      allow read: if isRegistered()
        && (requestId.matches('^' + request.auth.uid + '_.+$')
          || requestId.matches('^.+_' + request.auth.uid + '$')
          || resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    match /chat_reports/{reportId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.reason is string;
      allow read: if isModerator()
        || (request.auth != null && resource.data.reporterId == request.auth.uid);
      allow delete: if isModerator();
      allow update: if isAdmin();
    }

    match /private_conversations/{conversationId} {
      allow read: if isRegistered()
        && (conversationId.matches('^' + request.auth.uid + '_.+$')
          || conversationId.matches('^.+_' + request.auth.uid + '$')
          || request.auth.uid in resource.data.participantIds);
      allow create: if isRegistered()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'participantNames', 'lastMessage',
          'lastSenderId', 'updatedAt'
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedAt is timestamp;
      allow update: if isRegistered()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastSenderId', 'updatedAt'
        ])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isRegistered()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isRegistered()
          && request.auth.uid in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds;
        allow create: if isRegistered()
          && request.auth.uid in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.keys().hasOnly([
             'senderId', 'recipientId', 'text', 'imageUrl', 'imagePublicId', 'createdAt',
             'replyToMessageId', 'replyToText', 'reactions', 'reactionBy'
           ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.recipientId in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds
          && !exists(/databases/$(database)/documents/community_profiles/$(request.auth.uid)/blocked_users/$(request.resource.data.recipientId))
          && !exists(/databases/$(database)/documents/community_profiles/$(request.resource.data.recipientId)/blocked_users/$(request.auth.uid))
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (!request.resource.data.keys().hasAny(['imageUrl'])
              || (request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.size() <= 2048
                  && (request.resource.data.imageUrl == ''
                  || request.resource.data.imageUrl.matches('^https://res\\.cloudinary\\.com/fjxo93em/image/upload/.+'))))
          && (!request.resource.data.keys().hasAny(['imagePublicId'])
              || (request.resource.data.imagePublicId is string
                  && request.resource.data.imagePublicId.matches('^huhs_users/' + request.auth.uid + '/.+')))
          && (request.resource.data.text.size() > 0
              || (request.resource.data.keys().hasAny(['imageUrl'])
                  && request.resource.data.imageUrl.size() > 0))
           && request.resource.data.createdAt is timestamp;
         allow update: if isRegistered()
           && request.auth.uid in get(
             /databases/$(database)/documents/private_conversations/$(conversationId)
           ).data.participantIds
           && resource.data.senderId == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text'])
           && request.resource.data.text is string
           && request.resource.data.text.size() > 0
           && request.resource.data.text.size() <= 2000;
        allow delete: if isRegistered()
          && request.auth.uid in get(
            /databases/$(database)/documents/private_conversations/$(conversationId)
          ).data.participantIds
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /community_bans/{userId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /artist_claims/{artistId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    match /app_settings/{settingId} {
      allow read: if settingId == 'startup';
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isRegistered() && resource.data.recipientUid == request.auth.uid;
      allow create: if false;
      allow update: if isRegistered()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'archivedAt'])
        && (!request.resource.data.keys().hasAny(['readAt'])
            || request.resource.data.readAt == null
            || request.resource.data.readAt is timestamp)
        && (!request.resource.data.keys().hasAny(['archivedAt'])
            || request.resource.data.archivedAt == null
            || request.resource.data.archivedAt is timestamp);
      allow delete: if isRegistered() && resource.data.recipientUid == request.auth.uid;
    }

    match /voting_votes/{voteId} {
      allow read: if isAdmin();
      // Votes are written only by the validated submitVotingBallot callable.
      // This prevents a client from bypassing the all-required-categories rule.
      allow create, update, delete: if false;
    }

    match /voting_device_claims/{claimId} {
      // Device claims are server-only. The callable stores only a one-way
      // hash-derived document ID and the minimum data needed to prevent a
      // second account on the same app installation from voting again.
      allow read, create, update, delete: if false;
    }
  }
}
